# NomadQuant local configuration.
# Copy this file to .env and fill in paper-trading credentials.
# Never commit .env. Never put these values in the frontend.

# Locked. Any value other than paper is rejected at startup.
TRADING_MODE=paper

# Internal strategy capital limit. Locked to 100. This is not Alpaca account equity.
INITIAL_VIRTUAL_CAPITAL_USD=100

# Locked. Order submission is not implemented.
ALLOW_ORDER_SUBMISSION=false

# Locked. The live host https://api.alpaca.markets is rejected.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Leave blank to start in disconnected mode.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Local bind. 0.0.0.0 is rejected.
API_HOST=127.0.0.1
API_PORT=8000

# SQLite operational log. Not a research dataset.
DATABASE_PATH=data/nomadquant.db

# Daily research bars. Separate from the operational log. Gitignored.
MARKET_DATA_PATH=data/market.sqlite

# Experiment registry and simulated backtest evidence. Gitignored.
RESEARCH_PATH=data/research.sqlite

# Local AI research agents (Phase 4A). Ollama must run on this machine.
# Non-localhost hosts are rejected. Agents never receive broker credentials.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model name as shown by ollama list. Required for nomadquant-agent run.
OLLAMA_MODEL=
# Agent run history and generated memos. Gitignored.
AGENTS_PATH=data/agents.sqlite
AGENT_MEMO_ROOT=data/agent-memos
AGENT_BENCHMARK_PATH=data/agent-benchmarks.sqlite

# Phase 5A deterministic risk engine. Append-only evaluation history for a
# separate internal $100 ledger. Never Alpaca paper equity. Gitignored.
RISK_PATH=data/risk.sqlite
SHADOW_PATH=data/shadow.sqlite
NEWS_PATH=data/news.sqlite

# Internal shadow approval email. Leave SMTP blank to keep a local outbox preview.
# Approving records permission only. It does not submit a broker order.
APPROVAL_PATH=data/approvals.sqlite
APPROVAL_OUTBOX_DIR=data/approval-outbox
APPROVAL_TTL_MINUTES=60
APPROVAL_EMAIL_TO=
APPROVAL_EMAIL_FROM=nomadquant@localhost
APPROVAL_PUBLIC_BASE_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
